<!DOCTYPE html>
<html lang="en" data-theme="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover">
    <title>Edit Student - ERP Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <script src="/js/theme.js"></script>
</head>

<body>
    <div class="dashboard">

        <!-- Sidebar Navigation -->
        <%- include('partials/sidebar', { active: 'students' }) %>

        <!-- Main Content -->
        <main class="main">

            <!-- Top Bar -->
            <div class="topbar">
                <div class="header-left">
                    <button type="button" class="mobile-menu-toggle" aria-label="Open Navigation Menu" title="Open Menu">
                        <i class="fas fa-bars"></i>
                    </button>
                    <div>
                        <h1>Edit Student Profile</h1>
                        <p>Update information for <b><%= student ? student.name : 'Student' %></b></p>
                    </div>
                </div>

                <div class="header-right">
                    <a href="/students" class="btn-glow btn-secondary-glow btn-sm">
                        <i class="fas fa-arrow-left"></i> Back to Directory
                    </a>
                    <button type="button" class="theme-toggle-btn" aria-label="Toggle Theme" title="Toggle Light/Dark Theme">
                        <div class="theme-toggle-inner">
                            <div class="theme-icon-box">
                                <i class="fas fa-sun sun-icon"></i>
                            </div>
                            <span class="theme-label">Light</span>
                            <div class="theme-toggle-switch">
                                <span class="theme-toggle-knob"></span>
                            </div>
                        </div>
                    </button>
                    <div class="profile">
                        <div class="avatar">
                            <%= (locals.user && locals.user.name) ? locals.user.name.charAt(0).toUpperCase() : 'A' %>
                        </div>
                        <div>
                            <h4><%= (locals.user && locals.user.name) ? locals.user.name : 'Administrator' %></h4>
                            <small><%= (locals.user && locals.user.role === 'admin') ? 'Administrator' : 'Student (' + (locals.user && locals.user.roll ? locals.user.roll : '') + ')' %></small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Edit Student Glass Form Card -->
            <div class="glass-card" style="max-width: 800px; margin: 0 auto;">
                <div class="glass-card-header">
                    <h3><i class="fas fa-user-edit" style="color: #0ea5e9;"></i> Student Details</h3>
                    <span style="color: #9aa4c5; font-size: 13px;">ID: #<%= student ? student.id : '' %></span>
                </div>

                <form action="/students/update/<%= student ? student.id : '' %>" method="POST">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 25px;">
                        <div class="form-group">
                            <label><i class="fas fa-user"></i> Student Name</label>
                            <input type="text" name="name" class="glass-input" value="<%= student ? student.name : '' %>" required>
                        </div>

                        <div class="form-group">
                            <label><i class="fas fa-id-card"></i> Roll Number</label>
                            <input type="text" name="roll" class="glass-input" value="<%= student ? student.roll : '' %>" required>
                        </div>

                        <div class="form-group">
                            <label><i class="fas fa-graduation-cap"></i> Branch</label>
                            <select name="branch" class="glass-select" required>
                                <option value="Computer Science" <%= student && student.branch === 'Computer Science' ? 'selected' : '' %>>Computer Science</option>
                                <option value="Information Tech" <%= student && student.branch === 'Information Tech' ? 'selected' : '' %>>Information Tech</option>
                                <option value="Mechanical Eng" <%= student && student.branch === 'Mechanical Eng' ? 'selected' : '' %>>Mechanical Eng</option>
                                <option value="Electronics Eng" <%= student && student.branch === 'Electronics Eng' ? 'selected' : '' %>>Electronics Eng</option>
                                <option value="Civil Eng" <%= student && student.branch === 'Civil Eng' ? 'selected' : '' %>>Civil Eng</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label><i class="fas fa-calendar-alt"></i> Semester</label>
                            <input type="text" name="semester" class="glass-input" value="<%= student ? student.semester : '' %>" required>
                        </div>

                        <div class="form-group" style="grid-column: span 2;">
                            <label><i class="fas fa-phone"></i> Contact Phone</label>
                            <input type="text" name="phone" class="glass-input" value="<%= student ? student.phone : '' %>" required>
                        </div>
                    </div>

                    <div style="display: flex; gap: 15px; justify-content: flex-end;">
                        <a href="/students" class="btn-glow btn-secondary-glow">Cancel</a>
                        <button type="submit" class="btn-glow btn-primary-glow">
                            <i class="fas fa-save"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>

        </main>
    </div>
</body>

</html>