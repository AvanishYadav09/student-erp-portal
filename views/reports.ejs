<!DOCTYPE html>
<html lang="en" data-theme="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Attendance Reports - ERP Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <script src="/js/theme.js"></script>
</head>

<body>
    <div class="dashboard">

        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="logo">
                <h2>🎓 ERP Portal</h2>
            </div>
            <ul class="menu">
                <li><a href="/dashboard">🏠 Dashboard</a></li>
                <li><a href="/students">👨‍🎓 Students</a></li>
                <li><a href="/attendance">📅 Attendance</a></li>
                <li><a href="/marks">📝 Marks</a></li>
                <li class="active"><a href="/reports">📊 Reports</a></li>
                <li><a href="/logout">🚪 Logout</a></li>
            </ul>
        </aside>

        <!-- Main Content -->
        <main class="main">

            <!-- Top Bar -->
            <div class="topbar">
                <div class="header-left">
                    <h1>Attendance Reports & Analytics</h1>
                    <p>Detailed historical logs of student attendance records</p>
                </div>

                <div class="header-right">
                    <div class="search-box">
                        <i class="fas fa-search"></i>
                        <input type="text" id="reportSearch" placeholder="Search report records..." onkeyup="filterReportTable()">
                    </div>

                    <button type="button" class="theme-toggle-btn" title="Toggle Light/Dark Theme">
                        <i class="fas fa-moon"></i>
                        <span class="theme-label">Dark</span>
                    </button>

                    <div class="header-icon">
                        <i class="fas fa-bell"></i>
                        <span class="badge">3</span>
                    </div>

                    <div class="profile">
                        <div class="avatar">
                            <%= (locals.user && locals.user.name) ? locals.user.name.charAt(0).toUpperCase() : 'U' %>
                        </div>
                        <div>
                            <h4><%= (locals.user && locals.user.name) ? locals.user.name : 'User' %></h4>
                            <small><%= (locals.user && locals.user.role === 'admin') ? 'Administrator' : 'Student (' + (locals.user && locals.user.roll ? locals.user.roll : '') + ')' %></small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Stats Overview Cards -->
            <div class="cards">
                <div class="card purple">
                    <h2><%= reports ? reports.length : 0 %></h2>
                    <p>Total Log Entries</p>
                </div>
                <div class="card green">
                    <h2><%= reports ? reports.filter(r => r.status === 'Present').length : 0 %></h2>
                    <p>Total Present Logs</p>
                </div>
                <div class="card red">
                    <h2><%= reports ? reports.filter(r => r.status === 'Absent').length : 0 %></h2>
                    <p>Total Absent Logs</p>
                </div>
                <div class="card pink">
                    <h2><%= reports && reports.length ? Math.round((reports.filter(r => r.status === 'Present').length / reports.length) * 100) : 0 %>%</h2>
                    <p>Attendance Rate</p>
                </div>
            </div>

            <!-- Reports Table Card -->
            <div class="glass-card">
                <div class="glass-card-header">
                    <h3><i class="fas fa-file-invoice" style="color: #0ea5e9;"></i> Student Attendance History Log</h3>
                    <div style="display: flex; gap: 10px;">
                        <button onclick="filterStatus('all')" class="btn-glow btn-secondary-glow btn-sm">All Logs</button>
                        <button onclick="filterStatus('Present')" class="btn-glow btn-success-glow btn-sm">Present</button>
                        <button onclick="filterStatus('Absent')" class="btn-glow btn-danger-glow btn-sm">Absent</button>
                    </div>
                </div>

                <div class="table-container">
                    <table class="glass-table" id="reportsTable">
                        <thead>
                            <tr>
                                <th>Date recorded</th>
                                <th>Student Name</th>
                                <th>Attendance Status</th>
                                <th style="text-align: right;">System Log</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (reports && reports.length) { %>
                                <% reports.forEach(report => { %>
                                    <tr class="report-row" data-status="<%= report.status %>">
                                        <td>
                                            <span style="color: #cbd5e1; font-weight: 500;">
                                                <i class="far fa-calendar-alt" style="color: #0ea5e9; margin-right: 8px;"></i>
                                                <%= report.date %>
                                            </span>
                                        </td>
                                        <td>
                                            <div style="display: flex; align-items: center; gap: 10px;">
                                                <div class="avatar" style="width: 32px; height: 32px; font-size: 13px;">
                                                    <%= report.name ? report.name.charAt(0).toUpperCase() : 'S' %>
                                                </div>
                                                <b style="color: #fff;"><%= report.name %></b>
                                            </div>
                                        </td>
                                        <td>
                                            <% if (report.status === "Present") { %>
                                                <span class="pill-badge pill-present">
                                                    <i class="fas fa-check-circle"></i> Present
                                                </span>
                                            <% } else { %>
                                                <span class="pill-badge pill-absent">
                                                    <i class="fas fa-times-circle"></i> Absent
                                                </span>
                                            <% } %>
                                        </td>
                                        <td style="text-align: right; color: #5c688d; font-size: 13px;">
                                            <i class="fas fa-shield-alt" style="margin-right: 4px;"></i> Verified Record
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="4" style="text-align: center; color: #9aa4c5; padding: 30px;">
                                        <i class="fas fa-chart-line" style="font-size: 30px; margin-bottom: 10px; display: block; color: #5c688d;"></i>
                                        No attendance reports logged yet.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </main>
    </div>

    <script>
        function filterReportTable() {
            const query = document.getElementById('reportSearch').value.toLowerCase();
            const rows = document.querySelectorAll('.report-row');
            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                row.style.display = text.includes(query) ? '' : 'none';
            });
        }

        function filterStatus(status) {
            const rows = document.querySelectorAll('.report-row');
            rows.forEach(row => {
                if (status === 'all' || row.getAttribute('data-status') === status) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }
    </script>
</body>

</html>