<!DOCTYPE html>
<html lang="en" data-theme="light">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Dashboard</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <script src="/js/theme.js"></script>
</head>

<body>

    <div class="dashboard">

        <!-- Sidebar -->
        <aside class="sidebar">

            <div class="logo">
                <h2>🎓 ERP Portal</h2>
            </div>

            <ul class="menu">
                <li class="active"><a href="/dashboard">🏠 Dashboard</a></li>
                <li><a href="/students">👨‍🎓 Students</a></li>
                <li><a href="/attendance">📅 Attendance</a></li>
                <li><a href="/marks">📝 Marks</a></li>
                <li><a href="/reports">📊 Reports</a></li>
                <li><a href="/logout">🚪 Logout</a></li>
            </ul>

        </aside>

        <!-- Main Content -->
        <main class="main">

            <!-- Top Bar -->
            <div class="topbar">

                <div class="header-left">
                    <h1>Dashboard</h1>
                    <p>Welcome back, <%= (locals.user && locals.user.name) ? locals.user.name : 'User' %> 👋</p>
                </div>

                <div class="header-right">

                    <div class="search-box">
                        <i class="fas fa-search"></i>
                        <input type="text" placeholder="Search portal...">
                    </div>

                    <button type="button" class="theme-toggle-btn" title="Toggle Light/Dark Theme">
                        <i class="fas fa-moon"></i>
                        <span class="theme-label">Dark</span>
                    </button>

                    <div class="header-icon">
                        <i class="fas fa-bell"></i>
                        <span class="badge">3</span>
                    </div>

                    <div class="profile">
                        <div class="avatar">
                            <%= (locals.user && locals.user.name) ? locals.user.name.charAt(0).toUpperCase() : 'U' %>
                        </div>
                        <div>
                            <h4>
                                <%= (locals.user && locals.user.name) ? locals.user.name : 'User' %>
                            </h4>
                            <small>
                                <%= (locals.user && locals.user.role==='admin' ) ? 'Administrator' : 'Student (' +
                                    (locals.user && locals.user.roll ? locals.user.roll : '' ) + ')' %>
                            </small>
                        </div>
                    </div>

                </div>

            </div>

            <!-- Cards -->
            <div class="cards">
                <% if (locals.user && locals.user.role==='student' ) { %>
                    <div class="card purple">
                        <h2>
                            <%= locals.user.roll %>
                        </h2>
                        <p>Roll Number</p>
                    </div>
                    <div class="card green">
                        <h2>
                            <%= presentToday %> Days
                        </h2>
                        <p>My Days Present</p>
                    </div>
                    <div class="card red">
                        <h2>
                            <%= absentToday %> Days
                        </h2>
                        <p>My Days Absent</p>
                    </div>
                    <div class="card pink">
                        <h2>
                            <%= averageMarks %>%
                        </h2>
                        <p>My Academic Score</p>
                    </div>
                    <% } else { %>
                        <div class="card purple">
                            <h2>
                                <%= totalStudents %>
                            </h2>
                            <p>Total Students</p>
                        </div>
                        <div class="card green">
                            <h2>
                                <%= presentToday %>
                            </h2>
                            <p>Present Today</p>
                        </div>
                        <div class="card red">
                            <h2>
                                <%= absentToday %>
                            </h2>
                            <p>Absent Today</p>
                        </div>
                        <div class="card pink">
                            <h2>
                                <%= averageMarks %>%
                            </h2>
                            <p>Average Marks</p>
                        </div>
                        <% } %>
            </div>

            <!-- Welcome -->
            <div class="welcome">
                <h2>Welcome to Student ERP Portal 🚀</h2>
                <p>
                    <% if (locals.user && locals.user.role==='student' ) { %>
                        View your personal attendance logs, subject scores, and academic status in read-only mode.
                        <% } else { %>
                            Manage students, attendance, marks and reports from one unified dashboard.
                            <% } %>
                </p>
            </div>

            <!-- Attendance Graph -->
            <div class="graph-box">

                <h2>Attendance Overview</h2>

                <canvas id="attendanceChart" data-present="<%= presentToday %>" data-absent="<%= absentToday %>"></canvas>

            </div>
            <div class="analytics">

                <div class="performance-card">

                    <h2>📊 Monthly Performance</h2>

                    <canvas id="performanceChart"></canvas>

                </div>

                <div class="progress-card">

                    <h2>Attendance</h2>

                    <div class="circle">

                        <div class="inner">
                            <%= (presentToday + absentToday) > 0 ? Math.round((presentToday / (presentToday + absentToday)) * 100) : 87 %>%
                        </div>

                    </div>

                    <p>Overall Attendance Rate</p>

                </div>

            </div>
            <div class="bottom-section">

                <div class="activity-card">

                    <h2>Recent Activities</h2>

                    <div class="activity">
                        <span>👨‍🎓 New student registered</span>
                        <small>2 min ago</small>
                    </div>
                    <div class="quick-actions">

                        <div class="action-card">
                            <div class="icon">👨‍🎓</div>
                            <h3>Add Student</h3>
                            <a href="/students">Open</a>
                        </div>

                        <div class="action-card">
                            <div class="icon">📅</div>
                            <h3>Attendance</h3>
                            <a href="/attendance">Open</a>
                        </div>

                        <div class="action-card">
                            <div class="icon">📝</div>
                            <h3>Marks</h3>
                            <a href="/marks">Open</a>
                        </div>

                        <div class="action-card">
                            <div class="icon">📊</div>
                            <h3>Reports</h3>
                            <a href="/reports">Open</a>
                        </div>

                    </div>

                    <div class="activity">
                        <span>✅ Attendance Updated</span>
                        <small>15 min ago</small>
                    </div>

                    <div class="activity">
                        <span>📝 Marks Uploaded</span>
                        <small>1 hour ago</small>
                    </div>

                    <div class="activity">
                        <span>📊 Report Generated</span>
                        <small>Today</small>
                    </div>

                </div>

                <div class="top-card">

                    <h2>🏆 Top Performers</h2>

                    <% if (topStudents && topStudents.length) { %>
                        <% topStudents.forEach(student=> { %>
                            <div class="student">
                                <span>🏅 <%= student.name %></span>
                                <b>
                                    <%= student.total %>%
                                </b>
                            </div>
                            <% }) %>
                                <% } else { %>
                                    <p>No top students found.</p>
                                    <% } %>
                </div>

            </div>
        </main>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="/js/chart.js"></script>

</body>

</html>