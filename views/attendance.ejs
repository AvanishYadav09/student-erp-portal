<!DOCTYPE html>
<html lang="en" data-theme="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover">
    <title>Mark Attendance - ERP Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <script src="/js/theme.js"></script>
</head>

<body>
    <div class="dashboard">

        <!-- Sidebar Navigation -->
        <%- include('partials/sidebar', { active: 'attendance' }) %>

        <!-- Main Content -->
        <main class="main">

            <!-- Top Bar -->
            <div class="topbar">
                <div class="header-left">
                    <button type="button" class="mobile-menu-toggle" aria-label="Open Navigation Menu" title="Open Menu">
                        <i class="fas fa-bars"></i>
                    </button>
                    <div>
                        <h1>Attendance Marking</h1>
                        <p>Mark daily class attendance for all enrolled students</p>
                    </div>
                </div>

                <div class="header-right">
                    <button type="button" class="theme-toggle-btn" aria-label="Toggle Theme" title="Toggle Light/Dark Theme">
                        <div class="theme-toggle-inner">
                            <div class="theme-icon-box">
                                <i class="fas fa-sun sun-icon"></i>
                            </div>
                            <span class="theme-label">Light</span>
                            <div class="theme-toggle-switch">
                                <span class="theme-toggle-knob"></span>
                            </div>
                        </div>
                    </button>

                    <div class="header-icon">
                        <i class="fas fa-bell"></i>
                        <span class="badge">3</span>
                    </div>

                    <div class="profile">
                        <div class="avatar">
                            <%= (locals.user && locals.user.name) ? locals.user.name.charAt(0).toUpperCase() : 'U' %>
                        </div>
                        <div>
                            <h4><%= (locals.user && locals.user.name) ? locals.user.name : 'User' %></h4>
                            <small><%= (locals.user && locals.user.role === 'admin') ? 'Administrator' : 'Student (' + (locals.user && locals.user.roll ? locals.user.roll : '') + ')' %></small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Flash Notification Banner -->
            <%- include('partials/flash') %>

            <!-- Attendance Marking Form Glass Card -->
            <div class="glass-card">
                <form action="/attendance/save" method="POST" id="attendanceForm">
                    <div class="glass-card-header" style="flex-wrap: wrap; gap: 15px;">
                        <div>
                            <h3><i class="fas fa-calendar-check" style="color: #0ea5e9;"></i> Daily Attendance Register</h3>
                            <span style="color: #9aa4c5; font-size: 13px;">Mark & view student attendance logs by date</span>
                        </div>

                        <div style="display: flex; align-items: center; gap: 12px;">
                            <div class="form-group" style="flex-direction: row; align-items: center; gap: 10px; margin: 0;">
                                <label style="margin: 0; white-space: nowrap;"><i class="fas fa-calendar-day"></i> Select Date:</label>
                                <input type="date" name="date" class="glass-input" style="width: auto; padding: 8px 14px;" required value="<%= typeof selectedDate !== 'undefined' ? selectedDate : new Date().toISOString().split('T')[0] %>" onchange="window.location.href='/attendance?date='+this.value">
                            </div>

                            <% if (locals.user && locals.user.role === 'admin' && students && students.length) { %>
                                <div style="display: flex; gap: 6px;">
                                    <button type="button" class="btn-glow btn-success-glow btn-sm" onclick="markAll('Present')" title="Set all to Present">
                                        <i class="fas fa-check-double"></i> All Present
                                    </button>
                                    <button type="button" class="btn-glow btn-danger-glow btn-sm" onclick="markAll('Absent')" title="Set all to Absent">
                                        <i class="fas fa-times-circle"></i> All Absent
                                    </button>
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <div class="table-container table-responsive-wrapper" style="margin-bottom: 25px;">
                        <table class="glass-table">
                            <thead>
                                <tr>
                                    <th># ID</th>
                                    <th>Student Name</th>
                                    <th>Branch / Roll</th>
                                    <th style="text-align: center;">Mark Attendance Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (students && students.length) { %>
                                    <% students.forEach(student => { %>
                                        <% 
                                            const currentStatus = (typeof attendanceMap !== 'undefined' && attendanceMap[student.id]) 
                                                ? attendanceMap[student.id] 
                                                : 'Present';
                                        %>
                                        <tr>
                                            <td style="color: #0ea5e9; font-weight: bold;">#<%= student.id %></td>
                                            <td>
                                                <div style="display: flex; align-items: center; gap: 10px;">
                                                    <div class="avatar" style="width: 32px; height: 32px; font-size: 13px;">
                                                        <%= student.name ? student.name.charAt(0).toUpperCase() : 'S' %>
                                                    </div>
                                                    <b style="color: #fff;"><%= student.name %></b>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="pill-badge pill-branch"><%= student.branch %></span>
                                                <small style="color: #9aa4c5; margin-left: 6px;"><%= student.roll %></small>
                                            </td>
                                            <td style="text-align: center;">
                                                <div class="radio-toggle" style="justify-content: center;">
                                                    <label style="background: rgba(0, 230, 118, .1); border-color: rgba(0, 230, 118, .3); color: #00e676; cursor: pointer;">
                                                        <input type="radio" class="status-radio-present" name="status[<%= student.id %>]" value="Present" required <%= currentStatus === 'Present' ? 'checked' : '' %>>
                                                        <i class="fas fa-check"></i> Present
                                                    </label>
                                                    <label style="background: rgba(255, 82, 82, .1); border-color: rgba(255, 82, 82, .3); color: #ff5252; cursor: pointer;">
                                                        <input type="radio" class="status-radio-absent" name="status[<%= student.id %>]" value="Absent" <%= currentStatus === 'Absent' ? 'checked' : '' %>>
                                                        <i class="fas fa-times"></i> Absent
                                                    </label>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="4" style="text-align: center; color: #9aa4c5; padding: 30px;">
                                            <i class="fas fa-user-slash" style="font-size: 30px; margin-bottom: 10px; display: block; color: #5c688d;"></i>
                                            No students found in system. Please add students first.
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <div style="display: flex; justify-content: flex-end;">
                        <% if (locals.user && locals.user.role === 'admin') { %>
                            <button type="submit" class="btn-glow btn-success-glow" style="padding: 14px 30px; font-size: 16px;">
                                <i class="fas fa-save"></i> Save Attendance Register
                            </button>
                        <% } else { %>
                            <div class="pill-badge pill-branch" style="padding: 10px 20px;">
                                <i class="fas fa-lock"></i> Read-Only Attendance Register (Admin Access Required To Modify)
                            </div>
                        <% } %>
                    </div>
                </form>
            </div>

            <script>
                function markAll(status) {
                    if (status === 'Present') {
                        document.querySelectorAll('.status-radio-present').forEach(r => r.checked = true);
                    } else if (status === 'Absent') {
                        document.querySelectorAll('.status-radio-absent').forEach(r => r.checked = true);
                    }
                }
            </script>

        </main>
    </div>
</body>

</html>