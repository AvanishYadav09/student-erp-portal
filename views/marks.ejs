<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Marks</title>

    <link rel="stylesheet" href="/css/style.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

</head>

<body>

    <div class="dashboard">

        <div class="sidebar">

            <h2>🎓 ERP</h2>

            <a href="/dashboard"><i class="fa-solid fa-house"></i> Dashboard</a>

            <a href="/students"><i class="fa-solid fa-user-graduate"></i> Students</a>

            <a href="/attendance"><i class="fa-solid fa-calendar-check"></i> Attendance</a>

            <a href="/marks" class="active"><i class="fa-solid fa-book"></i> Marks</a>

            <a href="/reports"><i class="fa-solid fa-chart-column"></i> Reports</a>

            <a href="/"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>

        </div>

        <div class="content">

            <h1>📝 Student Marks</h1>

            <br>

            <form action="/marks/add" method="POST" class="marks-form">

                <select name="student_id" required>

                    <% students.forEach(student=>{ %>

                        <option value="<%= student.id %>">

                            <%= student.name %>

                        </option>

                        <% }) %>

                </select>

                <input type="number" name="total" placeholder="Enter Marks" required>

                <button type="submit">

                    Save Marks

                </button>

            </form>

            <br>

            <table class="report-table">

                <tr>

                    <th>Student</th>

                    <th>Marks</th>

                    <th>Grade</th>

                </tr>

                <% marks.forEach(mark=>{ %>

                    <tr>

                        <td>
                            <%= mark.name %>
                        </td>

                        <td>
                            <%= mark.total %>
                        </td>

                        <td>

                            <% if(mark.total>=90){ %>

                                <span class="present">A+</span>

                                <% }else if(mark.total>=75){ %>

                                    <span class="present">A</span>

                                    <% }else if(mark.total>=60){ %>

                                        <span class="absent" style="background:orange;">B</span>

                                        <% }else{ %>

                                            <span class="absent">C</span>

                                            <% } %>

                        </td>

                    </tr>

                    <% }) %>

            </table>

        </div>

    </div>

</body>

</html>